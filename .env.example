# Set these in the process environment; .env files are NOT auto-loaded.
DATABASE_PATH=data/feedback.db
SHADOW_MODE=1
SECURE_COOKIE=0
# Set SECURE_COOKIE=1 behind corporate HTTPS.
# Empty endpoints mean demo rules / local demo tracker / no media processing.
INTERNAL_ALLOWED_HOSTS=qwen.corp.example,media.corp.example,tracker.corp.example,tickets.corp.example
QWEN_URL=
QWEN_MODEL=Qwen-3.8
QWEN_TOKEN=
MEDIA_URL=
MEDIA_TOKEN=
TRACKER_URL=
TRACKER_TOKEN=
SOURCE_URL=
SOURCE_TOKEN=
